<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, on every Android version (the platform default still allows cleartext on Android 8). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
